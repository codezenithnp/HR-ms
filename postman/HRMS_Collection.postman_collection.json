{
  "info": {
    "_postman_id": "hrms-api-tests-v1",
    "name": "HRMS API Tests",
    "description": "Automated API test suite for HR Management System.\n\nPrerequisites:\n- Backend running on http://localhost:5000\n- DB seeded: cd backend && npm run seed\n\nRun with Newman:\n  npm install -g newman\n  newman run HRMS_Collection.postman_collection.json --reporters cli,htmlextra",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{authToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "authToken", "value": "" },
    { "key": "createdEmployeeDbId", "value": "" },
    { "key": "attendanceId", "value": "" },
    { "key": "leaveId", "value": "" },
    { "key": "leaveTypeId", "value": "" },
    { "key": "shiftId", "value": "" },
    { "key": "departmentId", "value": "" },
    { "key": "holidayId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "item": [
        {
          "name": "GET /api/health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Server is healthy - status 200', () => pm.response.to.have.status(200));",
            "pm.test('Response time < 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "Login as Admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Login successful - status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('Token returned', () => pm.expect(json).to.have.property('token'));",
            "pm.test('User role is admin', () => pm.expect(json.role).to.equal('admin'));",
            "pm.collectionVariables.set('authToken', json.token);"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@codezenith.com\",\"password\":\"Admin@123\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login - Invalid Credentials",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Rejects bad credentials - status 401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@codezenith.com\",\"password\":\"WrongPassword\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get Me",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('Has email field', () => pm.expect(json).to.have.property('email'));",
            "pm.test('Email matches admin', () => pm.expect(json.email).to.equal('admin@codezenith.com'));"
          ]}}],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Update Me",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('Name updated', () => pm.expect(json.name || json.data && json.data.name).to.exist);"
          ]}}],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Admin User\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Update Password",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Password updated - status 200', () => pm.response.to.have.status(200));"
